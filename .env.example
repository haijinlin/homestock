# Pooled Neon connection string used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct Neon connection string used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Created automatically when a public Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_example"

# Auth.js and Google OAuth. Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"
AUTH_GOOGLE_ID="google-oauth-client-id"
AUTH_GOOGLE_SECRET="google-oauth-client-secret"

# Comma-separated Google account emails allowed to edit inventory.
ADMIN_EMAILS="owner@example.com"

# Local-only, read-only synthetic portfolio capture mode. Vercel always ignores it.
SCREENSHOT_MODE=false
LIFEHUB_SUMMARY_SECRET=

# Pooled Neon connection string used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct Neon connection string used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Created automatically when a public Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_example"
